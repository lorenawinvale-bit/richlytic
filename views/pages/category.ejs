<div class="container" style="padding-top:40px;">
  <span class="eyebrow"><%= categoryName %></span>
  <h1 style="font-family:var(--font-serif); font-size:2rem; margin:12px 0 32px;">Net Worth Articles</h1>
  <div class="article-grid">
    <% articles.forEach(function(a, i) { %>
      <a href="/<%= a.slug %>" class="article-card reveal reveal-stagger" style="--reveal-index: <%= i %>;">
        <img src="<%= a.image %>" alt="<%= a.title %>">
        <div class="article-card-body">
          <span class="card-worth"><%= a.netWorth %></span>
          <h3><%= a.title %></h3>
          <p><%= a.excerpt %></p>
        </div>
      </a>
    <% }); %>
  </div>
</div>
