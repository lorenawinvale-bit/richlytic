<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.metaDescription || article.excerpt,
    image: site.baseUrl + article.image,
    datePublished: article.date,
    author: { '@type': 'Organization', name: article.author },
    publisher: { '@type': 'Organization', name: site.name, url: site.baseUrl },
    mainEntityOfPage: site.baseUrl + '/' + article.slug
  }) %>
</script>
<% if (article.faqs && article.faqs.length) { %>
<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: article.faqs.map(function(f) {
      return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } };
    })
  }) %>
</script>
<% } %>

<section class="article-hero">
  <div class="container">
    <nav class="breadcrumb">
      <a href="/">Home</a> &rsaquo; <a href="/net-worth">Net Worth</a> &rsaquo; <%= article.title %>
    </nav>
    <h1 class="article-title"><%= article.title %></h1>
    <div class="article-meta">
      <span><%= article.author %></span>
      <span>&middot;</span>
      <span><%= article.date %></span>
      <span>&middot;</span>
      <span><%= readMinutes %> min read</span>
    </div>
    <img src="<%= article.image %>" alt="<%= article.title %>" class="article-cover">
  </div>
</section>

<div class="container">
  <article class="article-body">
    <nav class="article-toc" id="article-toc" aria-label="Table of contents">
      <span class="article-toc-title">On this page</span>
      <ol id="article-toc-list"></ol>
    </nav>
    <%- article.content %>
  </article>
</div>
<script>
  (function(){
    var body = document.querySelector('.article-body');
    var list = document.getElementById('article-toc-list');
    var toc = document.getElementById('article-toc');
    if (!body || !list) return;
    var headings = Array.from(body.querySelectorAll('h2'));
    if (headings.length < 3) { if (toc) toc.style.display = 'none'; return; }
    var used = {};
    headings.forEach(function(h){
      var slug = h.textContent.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
      if (used[slug]) { used[slug]++; slug = slug + '-' + used[slug]; } else { used[slug] = 1; }
      h.id = slug;
      var li = document.createElement('li');
      var a = document.createElement('a');
      a.href = '#' + slug;
      a.textContent = h.textContent;
      li.appendChild(a);
      list.appendChild(li);
    });
  })();
</script>

<% if (related.length) { %>
<section class="container">
  <h2 class="section-title">Related Profiles</h2>
  <div class="article-grid">
    <% related.forEach(function(a, i) { %>
      <a href="/<%= a.slug %>" class="article-card reveal reveal-stagger" style="--reveal-index: <%= i %>;">
        <img src="<%= a.image %>" alt="<%= a.title %>">
        <div class="article-card-body">
          <span class="card-worth"><%= a.netWorth %></span>
          <h3><%= a.title %></h3>
          <p><%= a.excerpt %></p>
        </div>
      </a>
    <% }); %>
  </div>
</section>
<% } %>
